{
	"name": "mark-henry",
	"version": "0.1.0",
	"workspaces": {
		"packages": [
			"mj-js/*",
			"dot-js/*"
		],
		"engines": {
			"bun": ">=1.3.0",
			"node": ">=22.0.0"
		},
		"type": "module",
		"packageManager": "bun@1.3.14",
		"scripts": {
			"build": "bun scripts/build.ts && bun run tsgo",
			"test": "bun test",
			"typecheck": "tsgo --noEmit",
			"prepublishOnly": "bun run build",
			"resize-image": "bash scripts/resize-image.sh",
			"changeset": "bunx changeset",
			"changeset:version": "bunx changeset version",
			"changeset:publish": "bun run ci:publish",
			"release:prepare": "bun scripts/release-prepare.ts",
			"ci:version": "bun scripts/ci-version.ts",
			"ci:publish": "bun scripts/ci-publish.ts",
			"release:publish": "bun run build && bun run ci:publish"
		},
		"catalog": {
			"typescript": "^6.0.3",
			"@tsconfig/bun": "1.0.10",
			"@standard-schema/spec": "^1.1.0",
			"@standard-schema/utils": "^0.3.0",
			"@types/bun": "^1.3.14",
			"@types/node": "^25.9.1",
			"tslib": "^2.8.1",
			"bun-types": "^1.3.14",
			"better-result": "^2.7.0",
			"debug": "^4.4.3",
			"@types/debug": "^4.1.13",
			"zod": "^4.3.6"
		},
		"devDependencies": {
			"@changesets/cli": "^2.29.8",
			"vitest": "^4.1.0",
			"typescript": "catalog:",
			"@tsconfig/bun": "catalog:",
			"@types/bun": "catalog:",
			"better-result": "catalog:"
		}
	}
}
