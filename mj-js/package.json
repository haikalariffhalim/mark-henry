{
	"name": "mj-js",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun run scripts/build.ts && tsgo",
		"test": "bun test",
		"typecheck": "tsgo --noEmit",
		"postinstall": "chmod +x index.ts",
		"check": "ultracite check",
		"fix": "ultracite fix"
	},
	"bin": {
		"bun-serve": "src/index.ts"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0",
		"@standard-schema/utils": "^0.3.0",
		"@opentui/core": "0.1.97",
		"@opentui/react": "0.1.97",
		"@tsconfig/bun": "1.0.10",
		"fuse.js": "^7.1.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/bun": "1.3.10",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.14",
		"ultracite": "7.8.3",
		"debug": "^4.4.3",
		"@types/debug": "^4.1.13",
		"bun-types": "1.0.4",
		"react": "^19.2.4"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"main": "src/index.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./app": {
			"types": "./dist/app.d.ts",
			"default": "./src/app.ts"
		},
		"./renderer": {
			"types": "./dist/renderer.d.ts",
			"default": "./src/renderer.tsx"
		},
		"./prompt": {
			"types": "./dist/prompt/index.d.ts",
			"default": "./src/prompt/index.ts"
		},
		"./options": {
			"types": "./dist/options.d.ts",
			"default": "./src/options.ts"
		},
		"./events": {
			"types": "./dist/events.d.ts",
			"default": "./src/events.ts"
		},
		"./transport": {
			"types": "./dist/transport.d.ts",
			"default": "./src/transport.ts"
		},
		"./image": {
			"types": "./dist/image/index.d.ts",
			"default": "./src/image/index.ts"
		}
	}
}
