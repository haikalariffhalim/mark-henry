{
	"name": "mj-js",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "bun scripts/build.ts && bun run tsgo",
		"test": "bun test",
		"typecheck": "tsgo --noEmit",
		"prepublishOnly": "bun run build",
		"resize-image": "bash scripts/resize-image.sh",
		"changeset": "bunx changeset",
		"changeset:version": "bunx changeset version",
		"changeset:publish": "bun run ci:publish",
		"release:prepare": "bun scripts/release-prepare.ts",
		"ci:version": "bun scripts/ci-version.ts",
		"ci:publish": "bun scripts/ci-publish.ts",
		"release:publish": "bun run build && bun run ci:publish",
		"check": "ultracite check",
		"fix": "ultracite fix"
	},
	"module": "index.ts",
	"type": "module",
	"peerDependencies": {
		"typescript": "^5",
		"@types/bun": "1.3.10"
	},
	"bin": {
		"bun-serve": "src/index.ts"
	},
	"catalog": {
		"typescript": "^6.0.3",
		"@tsconfig/bun": "1.0.10",
		"@standard-schema/spec": "^1.1.0",
		"@standard-schema/utils": "^0.3.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"tslib": "^2.8.1",
		"bun-types": "^1.3.14",
		"better-result": "^2.7.0",
		"debug": "^4.4.3",
		"@types/debug": "^4.1.13",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"svg-path-bbox": "^2.1.0",
		"svg-path-segments": "^2.0.1",
		"svgpath": "^2.6.0",
		"@standard-schema/spec": "^1.1.0",
		"@standard-schema/utils": "^0.3.0",
		"@opentui/core": "0.1.97",
		"@opentui/react": "0.1.97",
		"@tsconfig/bun": "1.0.10",
		"fuse.js": "^7.1.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/bun": "latest",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.14",
		"ultracite": "7.8.3",
		"debug": "^4.4.3",
		"@types/debug": "^4.1.13",
		"bun-types": "1.0.4",
		"react": "^19.2.4"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		}
	}
}
