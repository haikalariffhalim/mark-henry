		"bun-types": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@biomejs/biome": "2.4.16",
		"@types/bun": "catalog:",
		"autoprefixer": "^10.4.20",
		"bun-plugin-html": "^2.1.4",
		"bun-html-live-reload": "^0.1.4",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.14",
		"ultracite": "7.8.3"
	}
